{
  "name": "grpc-graphql-server",
  "version": "1.2.1",
  "description": "Generates a GraphQL schema from gRPC Protobuf and creates the server",
  "main": "dist/index.js",
  "bin": "bin/index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint --fix .",
    "lint:fix": "eslint --fix",
    "build": "tsc",
    "prepack": "tsc"
  },
  "keywords": [
    "gRPC",
    "GraphQL"
  ],
  "repository": "https://github.com/single9/node-grpc-graphql-server",
  "author": "Duye Chen",
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "devDependencies": {
    "@apollo/server": "^4.13.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@graphql-tools/schema": "^10.0.38",
    "@types/debug": "^4.1.12",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.13",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.7.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "express": "^4.21.2",
    "google-protobuf": "^3.21.2",
    "graphql": "^16.9.0",
    "graphql-request": "^4.3.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.0",
    "grpc-tools": "^1.11.3",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.5",
    "prettier": "^2.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.8",
    "@grpc/proto-loader": "^0.7.13",
    "debug": "^4.3.4"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0",
    "@graphql-tools/schema": "^9.0.0 || ^10.0.0",
    "express": "^4.17.1",
    "graphql": "^16.0.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "@graphql-tools/schema": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-subscriptions": {
      "optional": true
    },
    "graphql-ws": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "testEnvironment": "node"
  }
}
